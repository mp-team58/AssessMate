# AssessMate Frontend Environment Configuration

# Backend REST API endpoint (Required)
# Development default: http://localhost:8080/api
# Production example: https://api.assessmate.com/api
VITE_API_BASE_URL=http://localhost:8080/api

# Public Production Website Base URL (Used for Canonical URLs, Open Graph, and Sitemaps)
# In development this defaults to https://assessmate.me to prevent localhost in production metadata.
# Production example: https://assessmate.me
VITE_SITE_URL=https://assessmate.me

# Google Analytics 4 Measurement ID (Optional, leave blank to disable)
# Example: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Google Search Console Verification Token (Optional meta tag verification)
# Example: abc123def456_xyz
VITE_GSC_VERIFICATION=

